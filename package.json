{
  "name": "serfit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "dev:server": "nodemon server/index.js",
    "dev:all": "concurrently -k -n web,api -c green,yellow \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node server/index.js",
    "test": "node --test tests/api.test.js",
    "backup": "node server/backup.js"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10",
    "vite": "^6.3.5"
  }
}
